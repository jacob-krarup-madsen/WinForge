<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WingetStore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WingetStore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinForge"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Unloaded="RootGrid_Unloaded" PointerPressed="RootGrid_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: back + identity left, theme toggle right. Right margin reserves space for system title bar buttons. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Margin="0,0,138,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="TitleBarBackButton"
                Grid.Column="0"
                Click="TitleBarBackButton_Click"
                Visibility="Collapsed"
                Background="Transparent" BorderThickness="0"
                VerticalAlignment="Center" Padding="6,0" Margin="4,0,0,0"
                AutomationProperties.Name="Go back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                <ImageIcon Width="16" Height="16" Source="Assets/AppIcon.ico" />
                <TextBlock Text="WinForge" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <Button
                Grid.Column="3"
                x:Name="ThemeToggleButton"
                Click="ThemeToggleButton_Click"
                ToolTipService.ToolTip="Switch to dark theme"
                AutomationProperties.Name="Switch to dark theme"
                Padding="8,4"
                Margin="0,0,6,0"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Center"
                MinWidth="32">
                <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE708;" FontSize="14" />
            </Button>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            OpenPaneLength="220"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Discover"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Installed Apps" Tag="installed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="UpdatesNavItem" Tag="updates" AutomationProperties.Name="Updates, none available">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Updates" VerticalAlignment="Center" />
                            <Border
                                x:Name="UpdatesBadgeContainer"
                                Grid.Column="1"
                                MinWidth="20"
                                Height="20"
                                CornerRadius="10"
                                Background="{ThemeResource SystemAccentColor}"
                                Margin="8,0,0,0"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="UpdatesBadgeText"
                                    Foreground="White"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="6,0,6,0" />
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Content="Feature Velocity" Tag="features">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73C;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="System Optimizer" Tag="optimizer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Grid Height="44" Padding="12,0">
                    <TextBlock
                        Text="WinForge v0.0.1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorDisabledBrush}"
                        FontSize="11" />
                </Grid>
            </NavigationView.PaneFooter>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
