<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetStore.Pages.OptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WingetStore.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="System Optimizer" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Performance tuning, telemetry debloating, memory flushing, and disk cleaning for Windows 11." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" />
            </StackPanel>

            <!-- Status InfoBar -->
            <InfoBar x:Name="OptInfoBar" IsOpen="False" IsClosable="True" />

            <!-- Optimizer Cards Grid -->
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card 1: Windows Performance & Privacy Debloat -->
                <Border Grid.Row="0" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE770;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Optimize Windows &amp; Disable Telemetry" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Disables telemetry, diagnostics tracking, background bloat services, and optimizes scheduling latency." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="OptimizeBtn" Grid.Column="2" Content="Run Optimizer" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" Click="OptimizeBtn_Click" />
                    </Grid>
                </Border>

                <!-- Card 2: Disk & Cache Cleanup -->
                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Clean Disk &amp; System Caches" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Removes temporary app cache, Windows update leftovers, log dumps, and user temporary files." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="CleanDiskBtn" Grid.Column="2" Content="Clean Disk" VerticalAlignment="Center" Click="CleanDiskBtn_Click" />
                    </Grid>
                </Border>

                <!-- Card 3: Memory Flush -->
                <Border Grid.Row="2" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE950;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Flush Standby List &amp; Memory" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Reclaims inactive RAM cache, clears modified pages, and minimizes active working sets." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="FlushMemoryBtn" Grid.Column="2" Content="Flush Memory" VerticalAlignment="Center" Click="FlushMemoryBtn_Click" />
                    </Grid>
                </Border>

                <!-- Card 4: System Audit -->
                <Border Grid.Row="3" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="System Privacy &amp; Health Audit" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Audits current Windows security, privacy toggles, and performance benchmark status." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="AuditBtn" Grid.Column="2" Content="Run Audit" VerticalAlignment="Center" Click="AuditBtn_Click" />
                    </Grid>
                </Border>

                <!-- Card 5: Undo / Restore Defaults -->
                <Border Grid.Row="4" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7A7;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Restore Default Windows Settings" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Re-enables default Windows services, telemetry settings, and resets performance flags." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="UndoBtn" Grid.Column="2" Content="Restore Defaults" VerticalAlignment="Center" Click="UndoBtn_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Console Output Expander -->
            <Expander Header="Execution Output" HorizontalAlignment="Stretch" IsExpanded="False">
                <TextBox x:Name="ConsoleOutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" 
                         FontFamily="Consolas" FontSize="12" Height="180" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
