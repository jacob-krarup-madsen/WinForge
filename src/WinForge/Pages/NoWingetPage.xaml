<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WingetStore.Pages.NoWingetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WingetStore.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <controls:ResponsivePageContainer>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="24" MaxWidth="480" HorizontalAlignment="Center">
                <!-- Icon -->
                <Border
                    Width="80"
                    Height="80"
                    CornerRadius="40"
                    Background="{ThemeResource SystemFillColorAlertBrush}"
                    HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE783;" Foreground="White" FontSize="40" />
                </Border>

                <!-- Text explaining issue -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Winget Not Found" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock 
                        Text="Windows Package Manager (Winget) was not found on your system. This application requires Winget to search, install, and update apps." 
                        FontSize="14" 
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                        TextWrapping="Wrap" 
                        TextAlignment="Center" />
                </StackPanel>

                <!-- Actions and Progress -->
                <StackPanel Spacing="16" HorizontalAlignment="Center" Width="300">
                    <Button 
                        x:Name="InstallButton" 
                        Content="Install Winget" 
                        Style="{StaticResource AccentButtonStyle}" 
                        Click="InstallButton_Click" 
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Install Winget" />
                    
                    <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="StatusText" Text="Downloading Winget installer..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Height="4" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </controls:ResponsivePageContainer>
</Page>
