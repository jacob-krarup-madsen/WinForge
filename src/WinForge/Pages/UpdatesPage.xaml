<Page
    x:Class="WingetStore.Pages.UpdatesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WingetStore.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WingetStore.Pages"
    xmlns:models="using:WingetStore.Models"
    xmlns:app="using:WingetStore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <controls:ResponsivePageContainer>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Panel -->
            <Grid Padding="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock" Text="Available Updates" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountSubtitle" VerticalAlignment="Center" FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="4,0,4,0" />
                    <ToggleButton x:Name="BulkSelectToggle" Click="BulkSelectToggle_Click"
                        Style="{StaticResource HeaderCommandToggleStyle}"
                        AutomationProperties.Name="Toggle bulk selection mode"
                        ToolTipService.ToolTip="Show checkboxes to select multiple packages for bulk operations">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE762;" FontSize="13" />
                            <TextBlock Text="Select" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.LastRefreshTimeText, Mode=OneWay}"
                        FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center" />
                    <Button Command="{x:Bind ViewModel.LoadUpgradesCommand}"
                        Style="{StaticResource AccentButtonStyle}" Padding="10,4"
                        AutomationProperties.Name="Refresh available updates list">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdateAllButton" Command="{x:Bind ViewModel.UpgradeAllCommand}"
                        Style="{StaticResource AccentButtonStyle}" Padding="14,4"
                        IsEnabled="False" AutomationProperties.Name="Update all applications">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE118;" FontSize="13" />
                            <TextBlock Text="Update All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Category Tabs / Search -->
            <StackPanel x:Name="FilterSortPanel" Grid.Row="1" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton Content="{x:Bind ViewModel.AppsCountText, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsCategoryApps, Mode=TwoWay}" Click="CategoryBtn_Click"
                        Style="{StaticResource CategoryToggleStyle}"
                        AutomationProperties.Name="Filter by applications" />
                    <ToggleButton Content="{x:Bind ViewModel.RedistCountText, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsCategoryRedist, Mode=TwoWay}" Click="CategoryBtn_Click"
                        Style="{StaticResource CategoryToggleStyle}"
                        AutomationProperties.Name="Filter by redistributables" />
                    <ToggleButton Content="{x:Bind ViewModel.AllCountText, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsCategoryAll, Mode=TwoWay}" Click="AllCategoryBtn_Click"
                        Style="{StaticResource CategoryToggleStyle}"
                        AutomationProperties.Name="Show all packages" />
                </StackPanel>

                <TextBox x:Name="UpdateFilterInput"
                    PlaceholderText="Filter updates by name, publisher, or package ID..."
                    Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Filter updates" />
            </StackPanel>

            <!-- Bulk Action Bar -->
            <Border x:Name="BulkActionBar" Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,8,16,8" Visibility="Collapsed" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <CheckBox x:Name="SelectAllCheckBox" Content="Select All" Checked="SelectAllCheckBox_Checked" Unchecked="SelectAllCheckBox_Unchecked" AutomationProperties.Name="Select all updates" />
                        <TextBlock x:Name="SelectedItemsCountText" Text="0 items selected" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BulkUpdateButton" Content="Update Selected" Click="BulkUpdateButton_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" AutomationProperties.Name="Update selected packages" />
                        <Button Content="Cancel" Click="CancelBulkSelect_Click" AutomationProperties.Name="Cancel bulk selection" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Global Progress Panel -->
            <Border x:Name="GlobalProgressPanel" Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Visibility="Collapsed">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing IsActive="True" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="GlobalProgressStatusText" Text="Updating apps..." FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="GlobalProgressPercentText" Grid.Column="1"
                        Text="0%" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <ProgressBar x:Name="GlobalProgressBar" Grid.Row="1" Grid.ColumnSpan="2"
                        Minimum="0" Maximum="100" Value="0" Height="6" />
                </Grid>
            </Border>

            <!-- Error Feedback InfoBar -->
            <InfoBar Grid.Row="4" Title="Load Failure"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Severity="Error" Margin="0,0,0,4" />

            <!-- Content Area -->
            <Grid Grid.Row="5">
                <ProgressRing x:Name="LoadingProgress" IsActive="True" Width="48" Height="48"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />

                <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE930;" FontSize="48" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="All apps are up to date!" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Card View (for 1-3 items) -->
                <ScrollViewer x:Name="CardScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CardItemsControl" ItemsSource="{x:Bind ViewModel.FilteredUpgrades, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WingetPackage">
                                <Border MaxWidth="640" HorizontalAlignment="Left"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="48" Height="48" VerticalAlignment="Center">
                                                <Border Width="48" Height="48" CornerRadius="6"
                                                    Background="{x:Bind PlaceholderBackground, Mode=OneWay}"
                                                    Visibility="{x:Bind app:App.CollapsedIf(HasIcon), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Initial, Mode=OneWay}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{x:Bind app:App.ToImageSource(IconUrl), Mode=OneWay}"
                                                    Width="48" Height="48" Visibility="{x:Bind app:App.VisibleIf(HasIcon), Mode=OneWay}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="18" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind Id}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="·" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind Source}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <controls:PackageProgressControl
                                                    IsInstalling="{x:Bind IsInstalling}"
                                                    StatusText="{x:Bind InstallStatusText, Mode=OneWay}"
                                                    Progress="{x:Bind InstallProgress, Mode=OneWay}"
                                                    LogRequested="ViewTaskLog_Click"
                                                    StatusPanelMinWidth="100"
                                                    LogButtonMargin="4,0,0,0" />
                                                <Button Content="Update" Click="UpdateSingle_Click"
                                                    IsEnabled="{x:Bind app:App.Not(IsInstalling), FallbackValue=True}"
                                                    Style="{StaticResource AccentButtonStyle}" Padding="16,8"
                                                    AutomationProperties.Name="Update package" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Installed" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Version}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <FontIcon Glyph="&#xE111;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Available" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind AvailableVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontFamily="Consolas" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Updates List -->
                <ListView x:Name="UpdatesList"
                    ItemsSource="{x:Bind ViewModel.FilteredUpgrades, Mode=OneWay}"
                    Visibility="Collapsed" IsItemClickEnabled="True"
                    ItemClick="UpdatesList_ItemClick" SelectionChanged="UpdatesList_SelectionChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    ScrollViewer.VerticalScrollMode="Enabled"
                    Padding="0,0,0,24">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource PackageListRowItemStyle}" />
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Grid Padding="12,4,12,4" ColumnSpacing="3"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" MinWidth="120" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                                <ColumnDefinition Width="Auto" MinWidth="80" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Click="HeaderName_Click" Style="{StaticResource SortHeaderButtonStyle}"
                                AutomationProperties.Name="Sort by Name">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Name" FontWeight="Bold" FontSize="14" />
                                    <FontIcon x:Name="HeaderNameGlyph" Glyph="&#xE74B;" FontSize="11"
                                        FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="HeaderVersion_Click" Style="{StaticResource SortHeaderButtonStyle}"
                                AutomationProperties.Name="Sort by Version">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Version / Available" FontWeight="Bold" FontSize="14" />
                                    <FontIcon x:Name="HeaderVersionGlyph" Glyph="&#xE74B;" FontSize="11"
                                        FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Click="HeaderPublisher_Click" Style="{StaticResource SortHeaderButtonStyle}"
                                AutomationProperties.Name="Sort by Publisher">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Publisher" FontWeight="Bold" FontSize="14" />
                                    <FontIcon x:Name="HeaderPublisherGlyph" Glyph="&#xE74B;" FontSize="11"
                                        FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="4" Text="Actions" FontWeight="Bold" FontSize="14"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:WingetPackage">
                            <Grid Padding="12,8,12,8" ColumnSpacing="3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" MinWidth="120" />
                                    <ColumnDefinition Width="*" MinWidth="90" />
                                    <ColumnDefinition Width="Auto" MinWidth="80" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="36" Height="36" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="4"
                                        Background="{x:Bind PlaceholderBackground, Mode=OneWay}"
                                        Visibility="{x:Bind app:App.CollapsedIf(HasIcon), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{x:Bind app:App.ToImageSource(IconUrl), Mode=OneWay}"
                                        Width="36" Height="36" Visibility="{x:Bind app:App.VisibleIf(HasIcon), Mode=OneWay}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{x:Bind Id}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Version}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <FontIcon Glyph="&#xE111;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,2,0" />
                                    <TextBlock Text="{x:Bind AvailableVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{x:Bind Publisher}" VerticalAlignment="Center"
                                    FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Publisher}" />

                                 <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                     <controls:PackageProgressControl
                                         IsInstalling="{x:Bind IsInstalling}"
                                         StatusText="{x:Bind InstallStatusText, Mode=OneWay}"
                                         Progress="{x:Bind InstallProgress, Mode=OneWay}"
                                         LogRequested="ViewTaskLog_Click" />

                                     <Button Content="Update" Click="UpdateSingle_Click"
                                         IsEnabled="{x:Bind app:App.Not(IsInstalling), FallbackValue=True}"
                                         Style="{StaticResource AccentButtonStyle}"
                                         Width="72" Height="26" FontSize="12"
                                         AutomationProperties.Name="Update package" />
                                 </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Status Footer -->
            <Border Grid.Row="6" Padding="0,8,0,0" Visibility="Collapsed" x:Name="StatusFooter">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.LastRefreshTimeText, Mode=OneWay}"
                        FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </controls:ResponsivePageContainer>
</Page>