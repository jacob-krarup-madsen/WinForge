<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetStore.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WingetStore.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WingetStore.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <controls:ResponsivePageContainer>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

                <Grid Grid.Row="1" MaxWidth="820" HorizontalAlignment="Left" RowSpacing="16" Margin="0,0,0,48">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Integration -->
                    <Border
                        Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Package Manager" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            x:Name="DiagnosticsStatusIcon"
                                            Glyph="&#xE73E;"
                                            FontSize="14"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            x:Name="DiagnosticsStatusText"
                                            Text="Checking connection..."
                                            FontSize="14"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="LastCheckedText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="Check Connection"
                                    Click="TestStatusButton_Click"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Check connection to Windows Package Manager" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notifications -->
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Show alerts when app operations complete or fail."
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="NotificationsToggle"
                                Grid.Column="1"
                                OnContent=""
                                OffContent=""
                                Toggled="NotificationsToggle_Toggled"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Enable app notifications" />
                        </Grid>
                    </Border>

                    <!-- Automatic Updates -->
                    <Border
                        Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Automatic Updates" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Automatically update installed packages when the app starts."
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoUpdateToggle"
                                Grid.Column="1"
                                OnContent=""
                                OffContent=""
                                Toggled="AutoUpdateToggle_Toggled"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Enable automatic updates" />
                        </Grid>
                    </Border>

                    <!-- About -->
                    <Border
                        Grid.Row="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="About" FontSize="15" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="WinForge" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="v0.0.1" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                Text="WinForge provides a modern native interface for Windows Package Manager, Feature Velocity (ViVeTool), and deep System Performance Optimization."
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Content="Licenses and acknowledgments"
                                    FontSize="13"
                                    Padding="0"
                                    NavigateUri="https://github.com/jacob-krarup-madsen/WinForge" />
                                <HyperlinkButton
                                    Grid.Column="1"
                                    Content="Report an issue"
                                    FontSize="13"
                                    Padding="0"
                                    NavigateUri="https://github.com/jacob-krarup-madsen/WinForge/issues" />
                            </Grid>
                            <TextBlock
                                Text="&#x00A9; 2026 WinForge"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </controls:ResponsivePageContainer>
</Page>
