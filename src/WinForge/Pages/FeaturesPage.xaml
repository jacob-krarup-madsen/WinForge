<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetStore.Pages.FeaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WingetStore.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="36,24,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Feature Velocity (ViVeTool)" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Manage and unlock experimental Windows 11 features and velocity flags." 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" />
        </StackPanel>

        <!-- Command Toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" PlaceholderText="Search by ID, name, or description..." TextChanged="SearchBox_TextChanged">
                <TextBox.Header>
                    <TextBlock Text="Filter Features" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBox.Header>
            </TextBox>

            <Button x:Name="EnableBtn" Grid.Column="1" VerticalAlignment="Bottom" Height="36" Style="{ThemeResource AccentButtonStyle}" Click="EnableBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    <TextBlock Text="Enable" />
                </StackPanel>
            </Button>

            <Button x:Name="DisableBtn" Grid.Column="2" VerticalAlignment="Bottom" Height="36" Click="DisableBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                    <TextBlock Text="Disable" />
                </StackPanel>
            </Button>

            <Button x:Name="RefreshBtn" Grid.Column="3" VerticalAlignment="Bottom" Height="36" Click="RefreshBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Features List -->
        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="FeaturesListView" SelectionMode="Multiple" SelectionChanged="FeaturesListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Status / Execution Output InfoBar -->
        <InfoBar x:Name="StatusInfoBar" Grid.Row="3" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
