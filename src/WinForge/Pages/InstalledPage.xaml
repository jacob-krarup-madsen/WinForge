<Page
    x:Class="WingetStore.Pages.InstalledPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WingetStore.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WingetStore.Pages"
    xmlns:models="using:WingetStore.Models"
    xmlns:app="using:WingetStore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <controls:ResponsivePageContainer>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Panel -->
            <Grid Padding="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Installed Apps" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="4,0,4,0" />
                    <ToggleButton x:Name="BulkSelectToggle" Click="BulkSelectToggle_Click"
                        Style="{StaticResource HeaderCommandToggleStyle}"
                        AutomationProperties.Name="Toggle bulk selection mode"
                        ToolTipService.ToolTip="Show checkboxes to select multiple packages for bulk operations">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE762;" FontSize="13" />
                            <TextBlock Text="Select" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Click="ImportButton_Click"
                        Style="{StaticResource HeaderCommandStyle}"
                        AutomationProperties.Name="Import packages"
                        ToolTipService.ToolTip="Import a package list from a winget JSON file">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B6;" FontSize="13" />
                            <TextBlock Text="Import" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="ExportButton_Click"
                        Style="{StaticResource HeaderCommandStyle}"
                        AutomationProperties.Name="Export packages"
                        ToolTipService.ToolTip="Export your installed package list as a winget-compatible JSON file">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEADE;" FontSize="13" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="LastRefreshText"
                        Text="{x:Bind ViewModel.LastRefreshTimeText, Mode=OneWay}"
                        FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center" />
                    <Button Command="{x:Bind ViewModel.LoadPackagesCommand}"
                        Style="{StaticResource AccentButtonStyle}" Padding="10,4"
                        AutomationProperties.Name="Refresh installed packages">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- InfoBars Row -->
            <StackPanel Grid.Row="1" Spacing="4">
                <InfoBar x:Name="StatusInfoBar" IsOpen="False" Severity="Informational" Title="" Message="" />
                <InfoBar Title="Load Failure" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Severity="Error" />
            </StackPanel>

            <!-- Bulk Action Bar -->
            <Border x:Name="BulkActionBar" Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,8,16,8" Visibility="Collapsed" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <CheckBox x:Name="SelectAllCheckBox" Content="Select All"
                            Checked="SelectAllCheckBox_Checked" Unchecked="SelectAllCheckBox_Unchecked"
                            AutomationProperties.Name="Select all installed packages" />
                        <TextBlock x:Name="SelectedItemsCountText" Text="0 items selected"
                            VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BulkUninstallButton" Content="Uninstall Selected"
                            Click="BulkUninstallButton_Click" Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="False" AutomationProperties.Name="Uninstall selected packages" />
                        <Button Content="Cancel" Click="CancelBulkSelect_Click"
                            AutomationProperties.Name="Cancel bulk selection" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Category Tabs / Search / Filter -->
            <StackPanel Grid.Row="3" Spacing="8">
                <!-- Category Selector Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton Content="{x:Bind ViewModel.AppsCountText, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsCategoryApps, Mode=TwoWay}" Click="CategoryBtn_Click"
                        Style="{StaticResource CategoryToggleStyle}"
                        AutomationProperties.Name="Filter by applications" />
                    <ToggleButton Content="{x:Bind ViewModel.RedistCountText, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsCategoryRedist, Mode=TwoWay}" Click="CategoryBtn_Click"
                        Style="{StaticResource CategoryToggleStyle}"
                        AutomationProperties.Name="Filter by redistributables" />
                    <ToggleButton Content="{x:Bind ViewModel.AllCountText, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsCategoryAll, Mode=TwoWay}" Click="AllCategoryBtn_Click"
                        Style="{StaticResource CategoryToggleStyle}"
                        AutomationProperties.Name="Show all packages" />
                </StackPanel>

                <!-- Filter Controls -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilterInput"
                        PlaceholderText="Filter by name, publisher, version, or package ID..."
                        Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Filter installed applications" />
                    <ComboBox Grid.Column="1" x:Name="DeveloperFilterCombo"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.DeveloperOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.DeveloperFilter, Mode=TwoWay}"
                        AutomationProperties.Name="Filter by developer" />
                </Grid>
            </StackPanel>

            <!-- Content Area -->
            <Grid Grid.Row="4">
                <ProgressRing x:Name="LoadingProgress" IsActive="True" Width="48" Height="48"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE71D;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No installed applications found matching criteria" FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ListView x:Name="InstalledAppsList" Visibility="Collapsed" IsItemClickEnabled="True"
                    ItemClick="InstalledAppsList_ItemClick" SelectionChanged="InstalledAppsList_SelectionChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    ScrollViewer.VerticalScrollMode="Enabled"
                    Padding="0,0,0,24">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource PackageListRowItemStyle}" />
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Grid Padding="12,4,12,4" ColumnSpacing="3"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                                <ColumnDefinition Width="Auto" MinWidth="36" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Click="HeaderName_Click" Style="{StaticResource SortHeaderButtonStyle}"
                                AutomationProperties.Name="Sort by Name">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Name" FontWeight="Bold" FontSize="14" />
                                    <FontIcon x:Name="HeaderNameGlyph" Glyph="&#xE74B;" FontSize="11"
                                        FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="HeaderVersion_Click" Style="{StaticResource SortHeaderButtonStyle}"
                                AutomationProperties.Name="Sort by Version">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Version" FontWeight="Bold" FontSize="14" />
                                    <FontIcon x:Name="HeaderVersionGlyph" Glyph="&#xE74B;" FontSize="11"
                                        FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Click="HeaderPublisher_Click" Style="{StaticResource SortHeaderButtonStyle}"
                                AutomationProperties.Name="Sort by Publisher">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Publisher" FontWeight="Bold" FontSize="14" />
                                    <FontIcon x:Name="HeaderPublisherGlyph" Glyph="&#xE74B;" FontSize="11"
                                        FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="4" Text="" FontWeight="Bold" FontSize="14"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:WingetPackage">
                            <Grid Padding="12,10,12,10" ColumnSpacing="3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="*" MinWidth="90" />
                                    <ColumnDefinition Width="*" MinWidth="90" />
                                    <ColumnDefinition Width="Auto" MinWidth="36" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="36" Height="36" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="4"
                                        Background="{x:Bind PlaceholderBackground, Mode=OneWay}"
                                        Visibility="{x:Bind app:App.CollapsedIf(HasIcon), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" Foreground="White"
                                            FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{x:Bind app:App.ToImageSource(IconUrl), Mode=OneWay}"
                                        Width="36" Height="36"
                                        Visibility="{x:Bind app:App.VisibleIf(HasIcon), Mode=OneWay}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{x:Bind Id}" FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind Version}" VerticalAlignment="Center"
                                    FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                <TextBlock Grid.Column="3" Text="{x:Bind Publisher}" VerticalAlignment="Center"
                                    FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Publisher}" />

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <controls:PackageProgressControl
                                        IsInstalling="{x:Bind IsInstalling}"
                                        StatusText="{x:Bind InstallStatusText, Mode=OneWay}"
                                        Progress="{x:Bind InstallProgress, Mode=OneWay}"
                                        LogRequested="ViewTaskLog_Click" />

                                    <Button Content="Update" Click="UpdateSingle_Click"
                                        IsEnabled="{x:Bind app:App.Not(IsInstalling), FallbackValue=True}"
                                        Visibility="{x:Bind local:InstalledPage.GetUpdateVisibility(Status), Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Width="72" Height="26" FontSize="12"
                                        AutomationProperties.Name="Update package" />
                                    <Button Click="UninstallSingle_Click"
                                        IsEnabled="{x:Bind app:App.Not(IsInstalling), FallbackValue=True}"
                                        Style="{StaticResource UninstallButtonStyle}"
                                        ToolTipService.ToolTip="Uninstall"
                                        AutomationProperties.Name="Uninstall package">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </controls:ResponsivePageContainer>
</Page>